# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# Database Connection
MONGODB_URI=mongodb+srv://your_db_user:your_password@scoutify.yhxzeim.mongodb.net/?appName=Scoutify
# DNS_SERVERS=8.8.8.8,8.8.4.4

# JWT Secrets (Generate secure random strings in production)
ACCESS_TOKEN_SECRET=your_jwt_access_secret_key_at_least_32_characters_long
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_at_least_32_characters_long

# Google OAuth Credentials (Get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Cloudinary Integration (Get these from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GEMINI_API_KEY=your_api_key

# Email Configuration (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=your_verified_email@gmail.comcom
